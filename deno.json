{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.19",
    "@wecom/aibot-node-sdk": "npm:@wecom/aibot-node-sdk@1.0.7",
    "pino": "npm:pino@10.3.1",
    "pino-pretty": "npm:pino-pretty@13.1.3"
  },
  "exclude": [".worktrees", ".superpowers"],
  "tasks": {
    "start": "deno run --env-file=.env -P main.ts",
    "start:watch": "deno run --watch --env-file=.env -P main.ts",
    "check": "deno check main.ts",
    "test": "deno test -P",
    "smoke": "deno run -P scripts/smoke-app-server.ts",
    "smoke-turn": "deno run --env-file=.env -P scripts/smoke-codex-turn.ts"
  },
  "permissions": {
    "default": {
      "env": true,
      "net": true,
      "read": true,
      "write": [".data", "logs"],
      "run": ["codex"],
      "sys": ["hostname"]
    }
  },
  "test": {
    "permissions": {
      "env": true,
      "read": true,
      "write": true,
      "run": ["codex"],
      "sys": ["hostname"]
    }
  },
  "fmt": {
    "exclude": [".vscode"]
  }
}
