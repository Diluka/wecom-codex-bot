BOT_ID=
BOT_SECRET=
# 可选；留空或未设置时所有请求都按 restricted 处理
# 原始值任意位置含控制符（包括 CR/LF）或 Unicode 行/段分隔符时也视为未配置
# 其他值会 trim 普通首尾空格，并与企业微信 sender user ID 进行区分大小写的精确匹配
WECOM_OWNER_USER_ID=
CODEX_WORKSPACE=.

# 私聊及群聊默认输出级别：off | line | excerpt | full
OUTPUT_LEVEL=full
# 标签级覆盖留空时继承 OUTPUT_LEVEL
OUTPUT_LEVEL_QUEUE=
OUTPUT_LEVEL_TURN=
OUTPUT_LEVEL_TOOL=
OUTPUT_LEVEL_TOOL_RESULT=
OUTPUT_LEVEL_CONTENT=
OUTPUT_LEVEL_PLAN=
OUTPUT_LEVEL_WARNING=
OUTPUT_LEVEL_ERROR=
OUTPUT_LEVEL_SHUTDOWN=
OUTPUT_LEVEL_SUBAGENT=

# 私聊及群聊默认标签显示方式：show | hide
OUTPUT_LABEL=show
# 标签级覆盖留空时继承 OUTPUT_LABEL
OUTPUT_LABEL_QUEUE=
OUTPUT_LABEL_TURN=
OUTPUT_LABEL_TOOL=
OUTPUT_LABEL_TOOL_RESULT=
OUTPUT_LABEL_CONTENT=
OUTPUT_LABEL_PLAN=
OUTPUT_LABEL_WARNING=
OUTPUT_LABEL_ERROR=
OUTPUT_LABEL_SHUTDOWN=
OUTPUT_LABEL_SUBAGENT=

# 工具输出格式：individual | merge_same | merge_all | summary
# summary 保留 CONTENT，并隐藏普通 TOOL 与 TOOL_RESULT 详情
OUTPUT_FORMAT_TOOL=individual

# 群聊覆盖留空时继承上面的私聊/默认配置
OUTPUT_GROUP_LEVEL=
OUTPUT_GROUP_LEVEL_QUEUE=
OUTPUT_GROUP_LEVEL_TURN=
OUTPUT_GROUP_LEVEL_TOOL=
OUTPUT_GROUP_LEVEL_TOOL_RESULT=
OUTPUT_GROUP_LEVEL_CONTENT=
OUTPUT_GROUP_LEVEL_PLAN=
OUTPUT_GROUP_LEVEL_WARNING=
OUTPUT_GROUP_LEVEL_ERROR=
OUTPUT_GROUP_LEVEL_SHUTDOWN=
OUTPUT_GROUP_LEVEL_SUBAGENT=

OUTPUT_GROUP_LABEL=
OUTPUT_GROUP_LABEL_QUEUE=
OUTPUT_GROUP_LABEL_TURN=
OUTPUT_GROUP_LABEL_TOOL=
OUTPUT_GROUP_LABEL_TOOL_RESULT=
OUTPUT_GROUP_LABEL_CONTENT=
OUTPUT_GROUP_LABEL_PLAN=
OUTPUT_GROUP_LABEL_WARNING=
OUTPUT_GROUP_LABEL_ERROR=
OUTPUT_GROUP_LABEL_SHUTDOWN=
OUTPUT_GROUP_LABEL_SUBAGENT=

# 留空时继承 OUTPUT_FORMAT_TOOL，支持相同的四种格式
OUTPUT_GROUP_FORMAT_TOOL=
